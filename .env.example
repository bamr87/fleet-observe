# Copy to .env (git-ignored) and fill in. Never commit .env.
# Every published port binds 127.0.0.1 only; these set the HOST port.
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana admin login. The password is REQUIRED: compose refuses to start without it.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
